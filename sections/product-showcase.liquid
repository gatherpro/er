<section class="product-showcase section-{{ section.id }}-padding">
  <div class="showcase-container page-width">
    {% if section.settings.heading != blank %}
      <div class="showcase-header">
        <h2 class="showcase-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <p class="showcase-description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign collection = collections[section.settings.collection] %}
    {% if collection == blank %}
      {% assign collection = collections.all %}
    {% endif %}

    <div class="product-showcase-grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="showcase-item" data-index="{{ forloop.index }}">
          <a href="{{ product.url }}" class="showcase-link">
            <div class="showcase-image">
              {% if product.featured_media != blank %}
                {{ product.featured_media | image_tag:
                  product.featured_media.alt,
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 400px, (min-width: 750px) 350px, calc(100vw - 40px)',
                  widths: '350, 400, 500, 600',
                  class: 'showcase-product-image'
                }}
                {% if product.media[1] != null and section.settings.show_secondary_image %}
                  {{ product.media[1] | image_tag:
                    product.media[1].alt,
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 400px, (min-width: 750px) 350px, calc(100vw - 40px)',
                    widths: '350, 400, 500, 600',
                    class: 'showcase-product-image showcase-image-hover'
                  }}
                {% endif %}
              {% else %}
                <div class="showcase-placeholder">
                  <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                    <rect width="100" height="100" rx="12" fill="#f5f5f7"/>
                    <path d="M35 35h30v30h-30v-30z" fill="#d1d1d6"/>
                    <circle cx="45" cy="45" r="3" fill="#ffffff"/>
                  </svg>
                </div>
              {% endif %}

              {% unless product.available %}
                <div class="showcase-badge sold-out">Sold Out</div>
              {% else %}
                {% if product.compare_at_price_max > product.price %}
                  {% assign discount_percentage = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max | round %}
                  <div class="showcase-badge sale">-{{ discount_percentage }}%</div>
                {% endif %}
              {% endunless %}
            </div>

            <div class="showcase-content">
              {% if section.settings.show_vendor and product.vendor != blank %}
                <p class="showcase-vendor">{{ product.vendor }}</p>
              {% endif %}

              <h3 class="showcase-title">{{ product.title }}</h3>

              <div class="showcase-price">
                {% render 'price-complete', product: product %}
              </div>

              {% if section.settings.show_description and product.description != blank %}
                <p class="showcase-excerpt">{{ product.description | strip_html | truncate: 120 }}</p>
              {% endif %}
            </div>
          </a>
        </div>
      {% else %}
        <div class="showcase-empty">
          <p>No products found in this collection.</p>
          <a href="/admin/collections" class="btn btn-outline">Add Products</a>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_view_all and collection.products_count > section.settings.products_to_show %}
      <div class="showcase-actions">
        <a href="{{ collection.url }}" class="btn btn-outline btn-large">
          View All {{ collection.title }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="btn-icon">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .product-showcase {
    background: var(--color-background);
  }

  .showcase-container {
    max-width: 1200px;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .showcase-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #1d1d1f 0%, #6e6e73 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .showcase-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .product-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .showcase-item {
    background: var(--color-background);
    border-radius: 1.5rem;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--color-border-light);
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .showcase-item:nth-child(1) { animation-delay: 0.1s; }
  .showcase-item:nth-child(2) { animation-delay: 0.2s; }
  .showcase-item:nth-child(3) { animation-delay: 0.3s; }
  .showcase-item:nth-child(4) { animation-delay: 0.4s; }

  .showcase-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    border-color: var(--color-accent);
  }

  .showcase-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .showcase-image {
    position: relative;
    aspect-ratio: 1;
    background: var(--color-background-secondary);
    overflow: hidden;
  }

  .showcase-product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .showcase-image-hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .showcase-item:hover .showcase-product-image:first-child {
    opacity: 0;
  }

  .showcase-item:hover .showcase-image-hover {
    opacity: 1;
  }

  .showcase-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  .showcase-badge.sale {
    background: var(--color-accent);
    color: white;
  }

  .showcase-badge.sold-out {
    background: var(--color-text-tertiary);
    color: white;
  }

  .showcase-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .showcase-content {
    padding: 1.5rem;
  }

  .showcase-vendor {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .showcase-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .showcase-price {
    margin-bottom: 0.75rem;
  }

  .showcase-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .showcase-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    background: var(--color-background-secondary);
    border-radius: 1rem;
    border: 2px dashed var(--color-border);
  }

  .showcase-actions {
    text-align: center;
    margin-top: 2rem;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .product-showcase-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .showcase-content {
      padding: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our most popular ergonomic solutions, designed to transform your workspace and enhance your productivity."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": "6"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second product image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": "60"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": "60"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}