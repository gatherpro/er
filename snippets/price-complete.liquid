<div class="price-complete">
  {% if product.compare_at_price_max > product.price %}
    <div class="price-wrapper price-on-sale">
      <span class="price-sale">
        {% if product.price_varies %}
          From {{ product.price_min | money }}
        {% else %}
          {{ product.price | money }}
        {% endif %}
      </span>
      <span class="price-original">
        {% if product.compare_at_price_varies %}
          From {{ product.compare_at_price_min | money }}
        {% else %}
          {{ product.compare_at_price | money }}
        {% endif %}
      </span>
    </div>
  {% else %}
    <div class="price-wrapper">
      <span class="price-regular">
        {% if product.price_varies %}
          From {{ product.price_min | money }}
        {% else %}
          {{ product.price | money }}
        {% endif %}
      </span>
    </div>
  {% endif %}

  {% if product.selected_or_first_available_variant.unit_price_measurement %}
    <div class="price-unit">
      <span class="price-unit-amount">{{ product.selected_or_first_available_variant.unit_price | money }}</span>
      <span class="price-unit-separator">/</span>
      <span class="price-unit-measurement">
        {%- if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 -%}
          {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}
        {%- endif -%}
        {{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
      </span>
    </div>
  {% endif %}

  {% unless product.available %}
    <div class="price-unavailable">
      <span class="price-unavailable-text">Sold Out</span>
    </div>
  {% endunless %}
</div>

<style>
  .price-complete {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .price-regular {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .price-on-sale .price-sale {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .price-original {
    font-size: 1rem;
    color: var(--color-text-tertiary);
    text-decoration: line-through;
  }

  .price-unit {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .price-unit-separator {
    margin: 0 0.125rem;
  }

  .price-unavailable {
    margin-top: 0.25rem;
  }

  .price-unavailable-text {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>